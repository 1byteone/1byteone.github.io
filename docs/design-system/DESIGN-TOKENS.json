{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "YOYO Night City 2077 UI tokens. These values describe the current Cyberpunk theme and are not automatically enforced by all CSS declarations.",
  "color": {
    "background": { "$type": "color", "$value": "#080808" },
    "backgroundDeep": { "$type": "color", "$value": "#000000" },
    "surface": { "$type": "color", "$value": "#111111" },
    "surfaceRaised": { "$type": "color", "$value": "#1c1c1c" },
    "textPrimary": { "$type": "color", "$value": "#ffffff" },
    "textSecondary": { "$type": "color", "$value": "#d9d9d9" },
    "textMuted": { "$type": "color", "$value": "#929292" },
    "line": { "$type": "color", "$value": "#454545" },
    "signalYellow": { "$type": "color", "$value": "#fcee0a" },
    "signalCyan": { "$type": "color", "$value": "#00f0ff" },
    "signalRed": { "$type": "color", "$value": "#fe1038" }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Barlow Condensed", "Arial Narrow", "Bahnschrift", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Cascadia Code", "SFMono-Regular", "Consolas", "monospace"] }
  },
  "fontSize": {
    "label": { "$type": "dimension", "$value": "9px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "title": { "$type": "dimension", "$value": "25px" },
    "section": { "$type": "dimension", "$value": "62px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "18": { "$type": "dimension", "$value": "72px" },
    "24": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "160ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "reveal": { "$type": "duration", "$value": "650ms" },
    "easeOut": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "easeInOut": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  },
  "target": {
    "minimumAA": { "$type": "dimension", "$value": "24px", "$description": "WCAG 2.2 SC 2.5.8 minimum, subject to exceptions and spacing conditions." },
    "recommended": { "$type": "dimension", "$value": "44px", "$description": "Project usability recommendation; not the WCAG 2.2 AA minimum." }
  }
}

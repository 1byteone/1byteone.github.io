			&lt;tr&gt;
					&lt;td&gt;🥇 &lt;strong&gt;Distributed Architecture&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;Microservice splitting, service governance, distributed transactions, message queues&lt;/td&gt;
					&lt;td&gt;mall-order-service, mall-seckill-service, Middleware&lt;/td&gt;
					&lt;td&gt;35%&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;🥈 &lt;strong&gt;Middleware Depth&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;Redis cache, ES search, RocketMQ messaging, Seata transactions, Sentinel rate limiting&lt;/td&gt;
					&lt;td&gt;docs/Middleware/ (11 middlewares)&lt;/td&gt;
					&lt;td&gt;30%&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;🥉 &lt;strong&gt;Business Implementation&lt;/strong&gt;&lt;/td&gt;
					&lt;td&gt;Product/User/Cart/Order CRUD, JWT auth, AOP logging&lt;/td&gt;
					&lt;td&gt;mall-product-service, mall-user-service, mall-cart-service&lt;/td&gt;
					&lt;td&gt;25%&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;🏅 &lt;strong&gt;Engineering&lt;/strong&gt;&lt;/td&gt;
